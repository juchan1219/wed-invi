# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#
#   ⚠️ 이미 배포한 뒤에 새 컴퓨터에서 세팅하는 거라면, 시크릿을 새로 만들지 말고
#      `vercel env pull .env.local` 로 배포본의 값을 그대로 받아오세요.
#      TOKEN_SECRET 이 다르면 이미 보낸 하객 URL이 전부 열리지 않습니다.
#
#   어떤 값을 어디서 구하는지: docs/env.md

# ── 필수 ────────────────────────────────────────────────────────────

# Supabase 연결 문자열 — 앱이 쓰는 값. **Transaction pooler (포트 6543)** 를 쓰세요.
# Supabase 대시보드 상단 > Connect > Transaction pooler 에서 복사합니다.
# 서버리스에서 커넥션이 고갈되지 않게 연결을 다중화해 주는 경로입니다.
#   ⚠️ 아래 호스트는 **예시**입니다. 리전 이름으로 조합하지 말고 대시보드에서 복사하세요.
#   ⚠️ 비밀번호에 @ # / 같은 문자가 있으면 URL 인코딩해야 합니다.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# 마이그레이션·drizzle-kit 전용 연결 문자열. **Session pooler (포트 5432)** 를 쓰세요.
# DDL과 advisory lock이 transaction 모드에서는 불안정해서 경로를 나눕니다.
# (Direct 연결은 IPv6 전용이라 Vercel 함수에서 못 붙습니다 — pooler를 쓰세요.)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

#   로컬 도커(docker-compose.dev.yml)로 개발할 때는 둘 다 같은 값입니다:
#   DATABASE_URL="postgres://postgres:postgres@localhost:55432/wedinvi"
#   DIRECT_URL="postgres://postgres:postgres@localhost:55432/wedinvi"

# 관리자 로그인 비밀번호 (예찬·주은 공용).
# 하객 명단이 걸려 있으니 20자 이상 무작위 문자열을 권장합니다.
ADMIN_PASSWORD="충분히-긴-비밀번호로-바꾸세요"

# 관리자 세션 쿠키 서명용 시크릿. 아무 값이나 무작위로.
#   생성: openssl rand -base64 32
SESSION_SECRET="여기에-무작위-32바이트-base64"

# 하객 URL 토큰(HMAC) 생성용 시크릿.
# ⚠️ 이 값을 바꾸면 이미 배포한 모든 하객 URL이 무효가 됩니다. 한 번 정하면 바꾸지 마세요.
#   생성: openssl rand -base64 32
TOKEN_SECRET="여기에-무작위-32바이트-base64"

# 배포 주소. OG 태그의 절대 URL과 공유 링크 생성에 쓰입니다.
# 로컬에서는 http://localhost:3000, 배포 후에는 실제 도메인.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 연락처·계좌 번호.
#
# 이 저장소는 **공개**라서 전화번호·계좌번호를 소스에 적으면 git 히스토리에 영구히
# 남고 자동 수집 대상이 된다. 그래서 이 두 종류만 환경변수로 받는다.
# 이름·은행·예금주·라벨은 src/config/wedding.ts 에 그대로 있다.
#
#   ⚠️ 비밀이 아니다. 청첩장 화면에 그대로 보이는 값이고, NEXT_PUBLIC_ 이라
#      빌드 시 번들에 인라인되어 브라우저에 실린다. 목적은 "숨기기"가 아니라
#      "공개 저장소에 남기지 않기"다.
#
#   ⚠️ 넣는 곳은 **Vercel 환경변수**다. GitHub Secret에 넣으면 소용없다 —
#      배포 빌드는 Vercel에서 돌고, Actions는 build를 하지 않는다(.github/workflows/ci.yml).
#
# 비워두면 해당 항목만 사라진다. 전부 비면 연락처·계좌 섹션이
# "등록된 연락처가 없습니다" / "등록된 계좌가 없습니다" 안내를 보인다.
NEXT_PUBLIC_PHONE_GROOM=""
NEXT_PUBLIC_PHONE_GROOM_FATHER=""
NEXT_PUBLIC_PHONE_GROOM_MOTHER=""
NEXT_PUBLIC_PHONE_BRIDE=""
NEXT_PUBLIC_PHONE_BRIDE_FATHER=""
NEXT_PUBLIC_PHONE_BRIDE_MOTHER=""

# 계좌번호는 은행 앱에 붙여넣기 좋게 하이픈을 포함해 적는다
# (복사 버튼은 숫자만 떼어내므로 하이픈이 있어도 무해하다).
NEXT_PUBLIC_ACCOUNT_GROOM=""
NEXT_PUBLIC_ACCOUNT_BRIDE=""
NEXT_PUBLIC_ACCOUNT_BRIDE_FATHER=""
NEXT_PUBLIC_ACCOUNT_BRIDE_MOTHER=""


# ── 선택 ────────────────────────────────────────────────────────────

# Vercel Blob 읽기/쓰기 토큰 (편지 본문 이미지 업로드용).
# Vercel 프로젝트에서 Storage > Blob 스토어를 만들면 자동 주입됩니다.
# ⚠️ 스토어를 만들 때 Access mode를 반드시 "Public"으로 고르세요.
#    (하객이 로그인 없이 봐야 하고, 생성 후에는 바꿀 수 없습니다)
# 비워두면 로컬 개발에서는 public/uploads/ 에 저장되어 그대로 테스트할 수 있고,
# 배포 환경에서는 이미지 첨부만 막힙니다(나머지 기능은 정상).
BLOB_READ_WRITE_TOKEN=""

# 카카오 JavaScript 키 (관리자 페이지의 '카카오톡 공유' 버튼용).
# developers.kakao.com 에서 앱 생성 → 앱 키 → JavaScript 키
# ⚠️ 플랫폼 > Web > 사이트 도메인에 배포 주소를 등록해야 동작합니다.
# 없으면 카카오 버튼이 숨겨지고, OS 공유/링크 복사는 정상 동작합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=""
# Experimental Rive override; leave empty for the reference-style image sequence.
# State machine: WeddingDance. Default view model: Dance, number: danceProgress (0..100).
NEXT_PUBLIC_DANCE_RIVE_SRC=
